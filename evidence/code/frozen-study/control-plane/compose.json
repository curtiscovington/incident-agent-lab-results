{
  "name": "bigspark-plane",
  "services": {
    "postgres": {
      "container_name": "cp-postgres",
      "image": "postgres:17-alpine",
      "networks": {
        "data": {
          "ipv4_address": "10.78.50.11",
          "interface_name": "eth0"
        }
      },
      "restart": "unless-stopped",
      "mem_limit": "768m",
      "cpus": 0.75,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "labels": {
        "lab.system": "control-plane",
        "lab.role": "database",
        "lab.zone": "data",
        "lab.domain": "a"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "environment": {
        "POSTGRES_DB": "plane",
        "POSTGRES_USER": "plane",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/db_password"
      },
      "secrets": [
        "db_password"
      ],
      "volumes": [
        "pg-data:/var/lib/postgresql/data",
        "./schema.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U plane -d plane"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20
      }
    },
    "nats-1": {
      "container_name": "cp-nats-1",
      "image": "nats:2.11-alpine",
      "networks": {
        "messaging": {
          "ipv4_address": "10.78.30.11",
          "interface_name": "eth0"
        }
      },
      "restart": "unless-stopped",
      "mem_limit": "384m",
      "cpus": 0.75,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "labels": {
        "lab.system": "control-plane",
        "lab.role": "messaging",
        "lab.zone": "messaging",
        "lab.domain": "a"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "command": [
        "-c",
        "/etc/nats/nats.conf"
      ],
      "volumes": [
        "./nats-1.conf:/etc/nats/nats.conf:ro",
        "nats-1:/data"
      ]
    },
    "nats-2": {
      "container_name": "cp-nats-2",
      "image": "nats:2.11-alpine",
      "networks": {
