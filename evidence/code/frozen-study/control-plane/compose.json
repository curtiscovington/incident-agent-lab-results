    "api-1": {
      "container_name": "cp-api-1",
      "image": "bigspark-control-plane:1",
      "networks": {
        "control": {
          "ipv4_address": "10.78.40.21",
          "interface_name": "eth0"
        },
        "data": {
          "ipv4_address": "10.78.50.21",
          "interface_name": "eth1"
        }
      },
      "restart": "unless-stopped",
      "mem_limit": "384m",
      "cpus": 0.75,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "labels": {
        "lab.system": "control-plane",
        "lab.role": "api",
        "lab.zone": "control",
        "lab.domain": "a"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "build": ".",
      "environment": {
        "NODE_NAME": "api-1",
        "ROLE": "api"
      },
      "secrets": [
        "db_password"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp"
      ],
      "cap_drop": [
        "ALL"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request;urllib.request.urlopen('http://localhost:8080/health',timeout=3)"
        ],
        "interval": "5s",
        "timeout": "4s",
        "retries": 3,
        "start_period": "20s"
      },
      "depends_on": {
        "postgres": {
          "condition": "service_healthy"
        }
      },
      "profiles": [
        "bootstrap-api"
      ]
    },
